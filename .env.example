# Cloudflare Turnstile secret key — https://dash.cloudflare.com/?to=/:account/turnstile
# (the matching public site key goes directly into index.html, it's not a secret)
TURNSTILE_SECRET_KEY=

# Resend API key — https://resend.com/api-keys
# Leave blank to skip sending email (signups still get verified, just not emailed).
RESEND_API_KEY=

# Where signup notifications are sent.
NOTIFY_TO_EMAIL=rentmanagement26@gmail.com

# Sender shown on the notification email. Must be a Resend-verified domain,
# or use the shared onboarding.resend.dev address below for testing.
NOTIFY_FROM_EMAIL=DomusPRO Waitlist <onboarding@resend.dev>
