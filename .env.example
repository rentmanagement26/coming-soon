# Cloudflare Turnstile secret key — https://dash.cloudflare.com/?to=/:account/turnstile
# (the matching public site key goes directly into index.html, it's not a secret)
TURNSTILE_SECRET_KEY=

# Gmail account used to send notification emails, and a 16-character App
# Password for it (needs 2-Step Verification enabled first):
# https://myaccount.google.com/apppasswords
# Leave GMAIL_APP_PASSWORD blank to skip sending email (signups still get
# verified, just not emailed).
GMAIL_USER=rentmanagement26@gmail.com
GMAIL_APP_PASSWORD=

# Where signup notifications are sent. Defaults to GMAIL_USER above.
NOTIFY_TO_EMAIL=rentmanagement26@gmail.com
